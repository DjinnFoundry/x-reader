{
  "name": "x-reader",
  "version": "0.4.0",
  "description": "Twitter/X CLI. Read X and publish posts or replies with images or video.",
  "type": "module",
  "bin": {
    "x-reader": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "pnpm run build",
    "start": "node dist/cli/index.js",
    "test": "pnpm run build && node --test tests/*.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "twitter",
    "x",
    "cli",
    "tweet",
    "reader",
    "twitter-api",
    "twitter-cli",
    "x-api",
    "tweet-reader",
    "twitter-scraper",
    "bookmarks",
    "timeline",
    "search-tweets",
    "post-tweets",
    "terminal",
    "command-line",
    "social-media"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DjinnFoundry/x-reader.git"
  },
  "homepage": "https://github.com/DjinnFoundry/x-reader#readme",
  "bugs": {
    "url": "https://github.com/DjinnFoundry/x-reader/issues"
  },
  "author": "DjinnFoundry",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.13",
      "onFail": "warn"
    }
  }
}
